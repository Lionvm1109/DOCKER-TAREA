# Copia este archivo a ".env" y ajusta los valores según tu entorno.
# Así las credenciales de la base de datos no quedan escritas en el código.
# Mientras no exista una base de datos disponible, la app arrancará igual
# y la página de alumnos se mostrará vacía (sin error).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db
